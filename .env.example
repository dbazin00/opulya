# Generate local credentials with npm run db:credentials before starting PostgreSQL.
# Production must use its own credentials, never a development password.
POSTGRES_USER=opulya
POSTGRES_DB=opulya
POSTGRES_PORT=5434
POSTGRES_PASSWORD_FILE=.secrets/postgres-password
DATABASE_URL=
# Required by integration/browser tests; never point this at the application database.
TEST_DATABASE_URL=
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
NODE_ENV=development
EMAIL_TRANSPORT=resend
RESEND_API_KEY=
EMAIL_FROM="Opulya <onboarding@resend.dev>"
EMAIL_VERIFICATION_MINUTES=60
# Test capture is available only with NODE_ENV=test and opulya_test, never in production.
# EMAIL_TEST_OUTBOX_DIR=
# Alpha Vantage backend-only key. Free tier: 25 calls/day; searches also consume calls.
ALPHA_VANTAGE_API_KEY=
MARKET_REQUESTS_PER_MINUTE=5
MARKET_REQUESTS_PER_DAY=25
# Disable the in-process schedule when an external cron runs the sync command.
MARKET_SCHEDULER_ENABLED=true
# Absolute lifetime and inactivity timeout, both enforced by the server.
SESSION_HOURS=8
SESSION_IDLE_MINUTES=15
# Set only when deployed behind a known single trusted reverse proxy.
TRUST_PROXY=false
