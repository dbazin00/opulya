# Local development only. Configure Vercel and Render separately; never upload this file.

# Application (local)
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000

# PostgreSQL (local Docker) and isolated tests
# Generate local credentials with npm run db:credentials; never reuse them in production.
POSTGRES_USER=opulya
POSTGRES_DB=opulya
POSTGRES_PORT=5434
POSTGRES_PASSWORD_FILE=.secrets/postgres-password
DATABASE_URL=
TEST_DATABASE_URL=

# Verification email. Keep send budgets below your provider allowance.
EMAIL_TRANSPORT=resend
RESEND_API_KEY=
EMAIL_FROM="Opulya <onboarding@resend.dev>"
EMAIL_VERIFICATION_MINUTES=60
EMAIL_SENDS_PER_HOUR=20
EMAIL_SENDS_PER_DAY=80
# Test capture is restricted to NODE_ENV=test and opulya_test.
# EMAIL_TEST_OUTBOX_DIR=

# Yahoo Finance: no API key. These are Opulya safety caps, not Yahoo quotas.
MARKET_DATA_ENABLED=true
MARKET_REQUESTS_PER_MINUTE=30
MARKET_REQUESTS_PER_DAY=1000

# Sessions and trusted reverse proxy
SESSION_HOURS=8
SESSION_IDLE_MINUTES=15
TRUST_PROXY=false
# Enable TRUST_PROXY only behind a known, single trusted reverse proxy.

# Public legal details: set identical values on Vercel AND Render.
# Production signup/verification is paused until all values are filled and reviewed.
# Existing verified users can still sign in, export or delete their data.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_RETENTION_DETAILS=
LEGAL_TRANSFER_DETAILS=
LEGAL_NOTICE_REVIEWED=false
# Keep LEGAL_NOTICE_REVIEWED=false until the actual notices and deployment are reviewed.
