{
  "name": "@opulya/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/main.js",
    "market:sync": "node dist/sync-prices.js",
    "db:backfill-balances": "node dist/backfill-balance-snapshots.js",
    "db:credentials": "tsx --tsconfig tsconfig.json src/database-credentials.ts",
    "typecheck": "tsc --project tsconfig.typecheck.json"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@opulya/shared": "0.0.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.3",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "luxon": "3.7.2",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.6",
    "@types/pg": "8.23.1"
